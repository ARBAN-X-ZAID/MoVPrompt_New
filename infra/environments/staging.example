# One private R2 bucket: use the same name for all three roles; leave preview URL empty.
R2_ACCOUNT_ID=
R2_TEMPLATE_PREVIEWS_BASE_URL=

# Guest production access fails closed until proxy and budget are configured.
GUEST_TRUST_PROXY=false
GUEST_DAILY_BUDGET_USD=
GUEST_MAX_RENDER_COST_USD=
