# Documentation contract only. Supply real values from the staging secret store;
# do not commit a populated copy.
APP_ENV=staging
PUBLIC_APP_URL=https://staging.example.invalid
WEB_ORIGIN=https://staging.example.invalid
API_ORIGIN=https://api.staging.example.invalid
CORS_ALLOWED_ORIGINS=https://staging.example.invalid
VITE_API_ORIGIN=https://api.staging.example.invalid
VITE_FEATURE_PORTABLE_AUTH=true
VITE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_FEATURE_GUEST_CREATOR=true
VITE_FEATURE_WORKSPACE_SHELL=true
