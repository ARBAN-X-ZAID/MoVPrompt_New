COMPOSE_PROJECT_NAME=movprompt-local

APP_ENV=local
PUBLIC_APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
VITE_API_ORIGIN=http://localhost:8787
# Requires `docker compose --profile application up`; use false for a web-only session.
VITE_FEATURE_PORTABLE_AUTH=true
VITE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_FEATURE_GUEST_CREATOR=true
VITE_FEATURE_WORKSPACE_SHELL=true
VITE_FEATURE_PROJECTS=true
VITE_FEATURE_ADVANCED_MODE=true
VITE_FEATURE_EXPORT_PIPELINE=false
# Optional client-demo simulation. It never calls an AI provider or charges credits.
VITE_FEATURE_LOCAL_DEMO_GENERATION=false
FEATURE_AUTHENTICATION=true
FEATURE_ASSETS=true
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_GENERATION=true
# Local test economics only; these are not production provider-cost evidence.
GENERATION_PRICING_VERSION=seedance-fast-local-2026-08-21
GENERATION_QUOTE_TTL_SECONDS=900
GENERATION_STARTER_ONLY=true
GENERATION_VIDEO_CINEMATIC_480P_CREDITS_PER_SECOND=3
GENERATION_VIDEO_CINEMATIC_720P_CREDITS_PER_SECOND=3
GENERATION_VIDEO_PRODUCT_FIDELITY_480P_CREDITS_PER_SECOND=3
GENERATION_VIDEO_PRODUCT_FIDELITY_720P_CREDITS_PER_SECOND=3
GENERATION_VIDEO_FIXED_RESOLUTION=
GENERATION_VIDEO_CINEMATIC_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_CREDITS_PER_SECOND=
GENERATION_IMAGE_PRODUCT_CREDITS_PER_IMAGE=
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=45
FEATURE_EXPORTS=false
FEATURE_BILLING=false

MONGODB_DATABASE=movprompt
MONGODB_PORT=27017
MONGODB_URI=mongodb://localhost:27017/movprompt?replicaSet=rs0&directConnection=true
MONGODB_POOL_MAX=20

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=
R2_OUTPUTS_BUCKET=
# Exact output host or leading-dot DNS suffix; never guess from documentation.
PROVIDER_OUTPUT_ALLOWED_HOSTS=ark-content-generation-ap-southeast-1.tos-ap-southeast-1.volces.com
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
VERCEL_GATEWAY_SEEDANCE_RESOLUTION_TIER=480p
VERCEL_GATEWAY_SEEDANCE_GENERATE_AUDIO=false
MOVPROMPT_PROVIDER_VERCEL_GATEWAY_READY=true
MOVPROMPT_GATEWAY_VIDEO_MODEL_ID=bytedance/seedance-v1.0-pro-fast
MOVPROMPT_GATEWAY_CONFIRM_PAID_VIDEO=NO
MOVPROMPT_GATEWAY_VIDEO_DURATION_SECONDS=2
MOVPROMPT_GATEWAY_VIDEO_ASPECT_RATIO=9:16
MOVPROMPT_GATEWAY_VIDEO_RESOLUTION_TIER=480p
MOVPROMPT_GATEWAY_VIDEO_RESOLUTION=480x864
MOVPROMPT_GATEWAY_VIDEO_IMAGE_PATH=apps/web/public/create/sample-kinza.jpg
MOVPROMPT_GATEWAY_VIDEO_IMAGE_URL=
MOVPROMPT_GATEWAY_VIDEO_TIMEOUT_MS=1200000
MOVPROMPT_GATEWAY_VIDEO_MAX_OUTPUT_BYTES=262144000
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MOVPROMPT_QUALITY_MODEL_ID=google/gemini-3.6-flash
MOVPROMPT_BENCHMARK_CONFIRM_PAID_RUN=NO
MOVPROMPT_BENCHMARK_RIGHTS_ATTESTED=NO
MOVPROMPT_BENCHMARK_ASSET_DIRECTORY=
MOVPROMPT_BENCHMARK_RUN_ID=
MOVPROMPT_BENCHMARK_MANIFEST_PATH=
MOVPROMPT_BENCHMARK_REPORT_PATH=
MOVPROMPT_BENCHMARK_CAPABILITY=video.product_fidelity
MOVPROMPT_BENCHMARK_COST_USD_PER_SECOND=
MOVPROMPT_BENCHMARK_CONCURRENCY=1
MOVPROMPT_BENCHMARK_POLL_INTERVAL_MS=5000
MOVPROMPT_BENCHMARK_SAMPLE_TIMEOUT_MS=1200000
MOVPROMPT_BENCHMARK_BRIEF_IDS=
R2_TEMPLATE_PREVIEWS_BUCKET=
R2_UPLOAD_URL_TTL_SECONDS=900
R2_DOWNLOAD_URL_TTL_SECONDS=900

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=MovPrompt <no-reply@localhost>

BETTER_AUTH_URL=http://localhost:8787
BETTER_AUTH_SECRET=movprompt-local-only-better-auth-secret-change-me
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=

WORKER_ID=movprompt-local-worker
WORKER_SMOKE_TEST_ON_START=true
WORKER_OUTBOX_BATCH_SIZE=20
WORKER_OUTBOX_LEASE_MS=60000
WORKER_OUTBOX_POLL_INTERVAL_MS=1000
WORKER_RENDER_RECONCILIATION_DELAY_SECONDS=15

MOVPROMPT_CAPABILITY_VIDEO_CINEMATIC_ENABLED=true
MOVPROMPT_CAPABILITY_VIDEO_CINEMATIC_ADAPTER_ID=vercel-ai-gateway
MOVPROMPT_CAPABILITY_VIDEO_CINEMATIC_MODEL_ID=bytedance/seedance-v1.0-pro-fast
MOVPROMPT_CAPABILITY_VIDEO_PRODUCT_FIDELITY_ENABLED=true
MOVPROMPT_CAPABILITY_VIDEO_PRODUCT_FIDELITY_ADAPTER_ID=vercel-ai-gateway
MOVPROMPT_CAPABILITY_VIDEO_PRODUCT_FIDELITY_MODEL_ID=bytedance/seedance-v1.0-pro-fast
MOVPROMPT_CAPABILITY_IMAGE_PRODUCT_ENABLED=false
MOVPROMPT_CAPABILITY_IMAGE_PRODUCT_ADAPTER_ID=
MOVPROMPT_CAPABILITY_IMAGE_PRODUCT_MODEL_ID=

API_PORT=8787

# One private R2 bucket: use the same name for all three roles; leave preview URL empty.
R2_ACCOUNT_ID=
R2_TEMPLATE_PREVIEWS_BASE_URL=

# Guest production access fails closed until proxy and budget are configured.
GUEST_TRUST_PROXY=false
GUEST_DAILY_BUDGET_USD=
GUEST_MAX_RENDER_COST_USD=
