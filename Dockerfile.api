# syntax=docker/dockerfile:1.7

FROM oven/bun:1.3.12 AS dependencies

WORKDIR /workspace

# Copy every workspace manifest so the frozen monorepo lockfile is evaluated
# against the same workspace graph without copying any .env file into the image.
COPY package.json bun.lock ./
COPY apps/api/package.json apps/api/package.json
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY packages/auth/package.json packages/auth/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/creative-engine/package.json packages/creative-engine/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/providers/package.json packages/providers/package.json
COPY packages/storage/package.json packages/storage/package.json

RUN bun install --frozen-lockfile

FROM dependencies AS build

COPY apps/api apps/api
COPY packages/auth packages/auth
COPY packages/contracts packages/contracts
COPY packages/creative-engine packages/creative-engine
COPY packages/db packages/db
COPY packages/providers packages/providers
COPY packages/storage packages/storage

RUN bun run --filter @movprompt/contracts build \
  && bun run --filter @movprompt/creative-engine build \
  && bun run --filter @movprompt/db build \
  && bun run --filter @movprompt/auth build \
  && bun run --filter @movprompt/providers build \
  && bun run --filter @movprompt/storage build \
  && bun run --filter @movprompt/api build

FROM oven/bun:1.3.12 AS bun-runtime
FROM node:24-bookworm-slim AS runtime

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /workspace
COPY --from=build --chown=node:node /workspace /workspace

ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

USER node

CMD ["node", "apps/api/dist/server.js"]
