{
  "name": "@movprompt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@movprompt/creative-engine": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "@movprompt/auth": "workspace:*",
    "@movprompt/contracts": "workspace:*",
    "@movprompt/db": "workspace:*",
    "@movprompt/providers": "workspace:*",
    "@movprompt/storage": "workspace:*",
    "hono": "^4.12.32",
    "mongodb": "^6.20.0",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
