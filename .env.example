# Runtime
NODE_ENV=development
APP_ENV=local
PUBLIC_APP_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:8080
API_ORIGIN=http://localhost:8787
API_PORT=8787
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Feature flags are server-controlled. Public Vite values only select local UI visibility.
FEATURE_TEMPLATE_MODE=true
FEATURE_ADVANCED_MODE=true
FEATURE_AUTHENTICATION=true
FEATURE_ASSETS=true
FEATURE_GENERATION=false
FEATURE_EXPORTS=false
FEATURE_BILLING=false
# Local-only unrestricted generation testing. Quotes remain internal and resolve
# to zero so idempotency and ownership checks stay active without payment UI.
DEVELOPMENT_FREE_GENERATION=false
VITE_API_ORIGIN=http://localhost:8787
# Enable only while the portable API is running (for Compose, use --profile application).
VITE_FEATURE_PORTABLE_AUTH=true
VITE_AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Social controls are shown only when the matching Better Auth provider is configured.
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_APPLE_ENABLED=false
VITE_FEATURE_GUEST_CREATOR=true
VITE_FEATURE_WORKSPACE_SHELL=true
VITE_FEATURE_PROJECTS=true
VITE_FEATURE_ADVANCED_MODE=true
VITE_FEATURE_EXPORT_PIPELINE=false
# Local client-demo only. Never enable this in staging or production.
VITE_FEATURE_LOCAL_DEMO_GENERATION=false
VITE_FEATURE_DEVELOPMENT_FREE_GENERATION=false

# MongoDB must be a replica set because billing and outbox writes use transactions.
MONGODB_URI=mongodb://localhost:27017/movprompt?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=movprompt
MONGODB_POOL_MAX=20

# Better Auth
BETTER_AUTH_URL=http://localhost:8787
# Known local-only value. Generate a unique secret for every shared environment.
BETTER_AUTH_SECRET=movprompt-local-only-better-auth-secret-change-me
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# The server owns the deferred first-campaign verification policy. Do not add
# the removed AUTH_REQUIRE_EMAIL_VERIFICATION variable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=
EMAIL_FROM=MovPrompt <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Cloudflare R2 is the only object storage provider. See docs/R2_SETUP.md.
# Provider media hosts, comma separated. Use an exact host or a leading-dot
# DNS suffix (for example .provider-cdn.example). HTTPS, public DNS resolution,
# pinned connections, redirects, MIME, MP4 magic and byte limits are enforced.
# Leave empty until a real accepted operation proves the provider hostname.
PROVIDER_OUTPUT_ALLOWED_HOSTS=

# Vercel AI Gateway. Use a project-scoped development key with a small budget.
# The local smoke CLI can discover models, verify authentication and generate
# a guarded paid video without exposing this key to the browser.
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
VERCEL_GATEWAY_SEEDANCE_RESOLUTION_TIER=720p
VERCEL_GATEWAY_SEEDANCE_GENERATE_AUDIO=false
# Keep false until the exact capability IDs below, private S3 storage,
# provider output host allowlist, FFmpeg/FFprobe and quality reviewer all pass.
MOVPROMPT_PROVIDER_VERCEL_GATEWAY_READY=false
MOVPROMPT_GATEWAY_VIDEO_MODEL_ID=bytedance/seedance-2.5
MOVPROMPT_GATEWAY_CONFIRM_PAID_VIDEO=NO
MOVPROMPT_GATEWAY_VIDEO_DURATION_SECONDS=4
MOVPROMPT_GATEWAY_VIDEO_ASPECT_RATIO=9:16
MOVPROMPT_GATEWAY_VIDEO_RESOLUTION_TIER=720p
MOVPROMPT_GATEWAY_VIDEO_RESOLUTION=720x1280
MOVPROMPT_GATEWAY_VIDEO_IMAGE_PATH=apps/web/public/create/sample-kinza.jpg
# Seedance 2.5 currently requires a public HTTPS image URL for this smoke.
MOVPROMPT_GATEWAY_VIDEO_IMAGE_URL=
MOVPROMPT_GATEWAY_VIDEO_TIMEOUT_MS=1200000
MOVPROMPT_GATEWAY_VIDEO_MAX_OUTPUT_BYTES=262144000
MOVPROMPT_GATEWAY_VIDEO_PROMPT=

# BytePlus ModelArk / Dreamina Seedance 2.0. Keep all capability flags false
# until the 48-brief benchmark and quality-review activation gate pass.

# Deterministic campaign speech. Arabic output accepts only Kuwait voices.

# Independent accepted-output review through the same server-only Gateway key.
# A video capability remains unavailable until FFprobe and this explicit
# multimodal language model are both configured. No provider-specific key or
# fallback model is used.
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
MOVPROMPT_QUALITY_MODEL_ID=google/gemini-3.6-flash

# Paid staging benchmark. These values are read only by `bun run --cwd
# apps/worker benchmark:live`; the command refuses to start without explicit
# paid-run confirmation and a complete private 48-brief asset manifest.
MOVPROMPT_BENCHMARK_CONFIRM_PAID_RUN=NO
MOVPROMPT_BENCHMARK_RIGHTS_ATTESTED=NO
MOVPROMPT_BENCHMARK_ASSET_DIRECTORY=
MOVPROMPT_BENCHMARK_RUN_ID=
MOVPROMPT_BENCHMARK_MANIFEST_PATH=
MOVPROMPT_BENCHMARK_REPORT_PATH=
MOVPROMPT_BENCHMARK_CAPABILITY=video.product_fidelity
MOVPROMPT_BENCHMARK_COST_USD_PER_SECOND=
MOVPROMPT_BENCHMARK_CONCURRENCY=1
MOVPROMPT_BENCHMARK_POLL_INTERVAL_MS=5000
MOVPROMPT_BENCHMARK_SAMPLE_TIMEOUT_MS=1200000
MOVPROMPT_BENCHMARK_BRIEF_IDS=

# Durable MongoDB outbox and reconciliation worker
WORKER_ID=movprompt-local-worker
WORKER_SMOKE_TEST_ON_START=true
WORKER_OUTBOX_BATCH_SIZE=20
WORKER_OUTBOX_LEASE_MS=60000
WORKER_OUTBOX_POLL_INTERVAL_MS=1000
WORKER_RENDER_RECONCILIATION_DELAY_SECONDS=15
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_MAX_AGE_SECONDS=45

# Approved capability providers. Raw provider IDs stay server-side.
SEEDANCE_API_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL_ID=
MOVPROMPT_CAPABILITY_VIDEO_CINEMATIC_ENABLED=false
MOVPROMPT_CAPABILITY_VIDEO_CINEMATIC_ADAPTER_ID=vercel-ai-gateway
# APP_ENV=local may explicitly use bytedance/seedance-v1.0-pro-fast for
# lower-cost testing. Staging and production must remain bytedance/seedance-2.5.
MOVPROMPT_CAPABILITY_VIDEO_CINEMATIC_MODEL_ID=bytedance/seedance-2.5
OMNI_FLASH_API_BASE_URL=
OMNI_FLASH_API_KEY=
OMNI_FLASH_MODEL_ID=
MOVPROMPT_CAPABILITY_VIDEO_PRODUCT_FIDELITY_ENABLED=false
MOVPROMPT_CAPABILITY_VIDEO_PRODUCT_FIDELITY_ADAPTER_ID=vercel-ai-gateway
MOVPROMPT_CAPABILITY_VIDEO_PRODUCT_FIDELITY_MODEL_ID=bytedance/seedance-2.5
NANO_BANANA_API_BASE_URL=
NANO_BANANA_API_KEY=
NANO_BANANA_MODEL_ID=
MOVPROMPT_CAPABILITY_IMAGE_PRODUCT_ENABLED=false
MOVPROMPT_CAPABILITY_IMAGE_PRODUCT_ADAPTER_ID=
MOVPROMPT_CAPABILITY_IMAGE_PRODUCT_MODEL_ID=
# Every additional semantic capability follows the same three server-only
# variables, for example MOVPROMPT_CAPABILITY_AVATAR_ENROLL_{ENABLED,ADAPTER_ID,MODEL_ID}.
PROVIDER_WEBHOOK_SECRET=

# Authoritative credit pricing. Leave blank to keep generation fail-closed.
# Values must be set only after the live provider bake-off and commercial approval.
GENERATION_PRICING_VERSION=
GENERATION_QUOTE_TTL_SECONDS=
# Private beta guard. Keep true until five accepted cost samples exist per resolution.
GENERATION_STARTER_ONLY=true
# Preferred resolution-bound pricing. Configure only rates approved from the
# live provider cost bake-off; a missing requested tier fails closed.
GENERATION_VIDEO_CINEMATIC_480P_CREDITS_PER_SECOND=
GENERATION_VIDEO_CINEMATIC_720P_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_480P_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_720P_CREDITS_PER_SECOND=
# Legacy single-tier pricing is accepted only with a matching fixed tier.
GENERATION_VIDEO_FIXED_RESOLUTION=
GENERATION_VIDEO_CINEMATIC_CREDITS_PER_SECOND=
GENERATION_VIDEO_PRODUCT_FIDELITY_CREDITS_PER_SECOND=
GENERATION_IMAGE_PRODUCT_CREDITS_PER_IMAGE=

# UPayments hosted checkout (KWD credit bundles)
UPAYMENTS_API_BASE_URL=https://sandboxapi.upayments.com
UPAYMENTS_API_KEY=
UPAYMENTS_MERCHANT_ID=
UPAYMENTS_WEBHOOK_SECRET=
UPAYMENTS_SUCCESS_URL=http://localhost:8080/billing/success
UPAYMENTS_CANCEL_URL=http://localhost:8080/billing/cancel

# Legacy Supabase is read-only during migration and must not be used by the new runtime.
LEGACY_SUPABASE_URL=
LEGACY_SUPABASE_SERVICE_ROLE_KEY=
LEGACY_SUPABASE_STORAGE_BUCKETS=

# Existing frontend compatibility only; remove at final cutover.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# One private Cloudflare R2 bucket: set all three role names to the same bucket.
# Leave the public preview URL empty; the API serves approved demos.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=
R2_OUTPUTS_BUCKET=
R2_TEMPLATE_PREVIEWS_BUCKET=
R2_TEMPLATE_PREVIEWS_BASE_URL=

# Public guest generation: configure proxy trust and audited provider cost limits before launch.
GUEST_TRUST_PROXY=false
GUEST_DAILY_BUDGET_USD=
GUEST_MAX_RENDER_COST_USD=
